# engineer-bot 환경변수. 복사해서 .env 로 쓴다 (.gitignore 대상).
#
# BUILD-PLAN §3 결정 테이블의 I1~I5가 아직 미결이므로, 모든 인프라 선택을
# 여기서 추상화해 뒀다. 결정이 나면 값만 채우면 코드 변경 없이 동작한다.

# ─── 대상 레포 ────────────────────────────────────────────────
# 봇이 빌드하는 제품 레포. 하네스 레포(engineer-bot)가 아니다.
TARGET_REPO=/path/to/cvc-or-dcx

# ─── Claude Code (I2 미결) ────────────────────────────────────
# 권고: API 키. headless 세션이 다수 병렬이므로 사용량 추적·한도 관리가 필수.
# ANTHROPIC_API_KEY=sk-ant-...

# SDD 컨트롤러 세션의 모델. 서브에이전트 모델은 SDD가 태스크별로 정한다.
# BUILDER_MODEL=claude-opus-5

# 세션 타임아웃 — 무한 루프의 최종 방어선 (AMENDMENTS A2). 기본 4시간.
# BUILDER_TIMEOUT_MS=14400000

# ─── 상태 저장소 (I4) ─────────────────────────────────────────
STATE_DB=state.sqlite

# ─── Slack (I3 미결) ──────────────────────────────────────────
# 권고: Socket Mode — 사내 호스트에 공개 엔드포인트를 노출하지 않아도 된다.
#
# 스레드 게시에는 봇 토큰이 필요하다. webhook은 스레드를 지정할 수 없어
# 스레드=세션인 이 설계(명세 §2)에서는 폴백일 뿐이다.
# SLACK_BOT_TOKEN=xoxb-...
# SLACK_APP_TOKEN=xapp-...        # Socket Mode 연결용 (Phase 3-B)
# SLACK_CHANNEL=C0XXXXXXX         # #dcx-개발
# SLACK_WEBHOOK_URL=              # 폴백. 스레드 게시 불가
SLACK_DRY_RUN=1                   # 1이면 실제로 보내지 않고 대상만 반환

# ─── GitHub (I5 미결) ─────────────────────────────────────────
# 권고: planner/builder 자격증명 분리 2개. §8 권한 매트릭스를 기계적으로
# 강제하는 유일한 방법이다 (AMENDMENTS §0.2).
#   planner: contents:write (docs/plans/** 만)
#   builder: contents:write + pull_requests:write, **머지 권한 없음**
# GH_TOKEN_PLANNER=
# GH_TOKEN_BUILDER=

# ─── 데모 파이프라인 (명세 §7 Phase 1) ────────────────────────
# PR 트리거로 Vercel이 배포한 프리뷰 URL. 보고 패킷에 실린다.
# ⚠️ 프리뷰 URL은 기본 공개 접근이다 (명세 D2). 사내 데이터가 붙는 화면이
#    생기면 Vercel 배포 보호를 켜야 한다.
# PREVIEW_URL=
