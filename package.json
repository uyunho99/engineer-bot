{
  "name": "engineer-bot",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Supervised development harness: Claude native",
  "scripts": {
    "test": "bun test src",
    "typecheck": "tsc --noEmit",
    "check": "bun run typecheck && bun test src",
    "plan": "bun run src/cli.ts plan",
    "smoke": "bun test src/harness.test.ts",
    "harness": "bun run src/cli.ts",
    "build": "bun build src/cli.ts --target=bun --outdir=dist",
    "evidence": "bun run src/evidence.ts"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "typescript": "^5.9.0"
  }
}
